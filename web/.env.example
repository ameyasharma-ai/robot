# ------------------------------------------------------------------------------
# 🌐 Robot Core Web-Hosted Stack — Environment Configuration
# Free-Tier Serverless Deployments (Vercel / Cloudflare Pages)
# ------------------------------------------------------------------------------

# 1. Groq Cloud (Ultra-Fast Free Whisper Transcription)
# Get key: https://console.groq.com/keys (Free 30 RPM / 14,400 RPD)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Google Gemini API (Free Generative Reasoning & Prompt Caching)
# Get key: https://aistudio.google.com/app/apikey (Free 15 RPM / 1,500 RPD)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# 3. Supabase Free PostgreSQL & pgvector (Conversation History & Semantic Memory)
# Get project: https://supabase.com/dashboard (Free 500MB database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 4. Optional Microsoft Edge TTS Voice
EDGE_TTS_VOICE=en-US-AvaNeural
