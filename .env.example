# Robot Core Configuration
# Copy to .env and update values

# LLM Server
LLAMA_SERVER_URL=http://127.0.0.1:8080/v1
LLAMA_MODEL_PATH=/home/ameya/Downloads/Qwen3.5-4B-Q4_K_M.gguf

# STT Server
WHISPER_SERVER_URL=http://127.0.0.1:8081/inference

# TTS
PIPER_MODEL_PATH=models/tts/en-us-lessac-medium.onnx

# Memory - Mem0 (local self-hosted)
MEM0_VECTOR_STORE=qdrant
MEM0_QDRANT_HOST=localhost
MEM0_QDRANT_PORT=6333
MEM0_COLLECTION=robot_memory
MEM0_EMBEDDING_DIMS=768

# Robot Core API
ROBOT_API_HOST=127.0.0.1
ROBOT_API_PORT=8888

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Audio
SAMPLE_RATE=16000
VAD_FRAME_SIZE=512
