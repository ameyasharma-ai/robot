# ==============================================================================
# 🤖 ROBOT CORE — EXAMPLE ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and configure your local or cloud credentials:
#   cp .env.example .env

# ─── 1. LLM ENGINE & PROVIDER SELECTOR ───────────────────────────────────────
# Active provider: 'local' (RTX 3050 llama-server), 'gemini' (Cloud 1M), or 'openai_compatible'
LLM_PROVIDER=local

# Local llama-server (Offloaded 100% to NVIDIA GeForce RTX 3050 Mobile with FlashAttention)
LLAMA_SERVER_URL=http://127.0.0.1:8080/v1
LLAMA_MODEL_PATH=/home/ameya/Downloads/Qwen3.5-4B-Q4_K_M.gguf
LLM_MODEL=Qwen3.5-4B-Q4_K_M
LLM_CONTEXT_WINDOW=16384
LLM_MAX_TOKENS=400
LLM_ENABLE_THINKING=false
LLM_MULTIMODAL=false
LLM_MMPROJ_PATH=models/vision/mmproj-Qwen3.5-4B-F16.gguf

# ─── 2. GOOGLE GEMINI CLOUD PROVIDER ─────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash
GEMINI_CONTEXT_WINDOW=1000000

# ─── 3. OPENAI-COMPATIBLE CUSTOM API (OpenAI / OpenRouter / DeepSeek / Ollama) 
# Supports any OpenAI-compatible endpoint with real-time prompt caching & model scanning
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4o
OPENAI_COMPATIBLE_CONTEXT_WINDOW=128000
OPENAI_COMPATIBLE_ENABLE_PROMPT_CACHING=true
 
# ─── 3b. OPENROUTER FREE & UNIVERSAL API PRESET ──────────────────────────────
# OpenRouter API key for free and commercial models (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ─── 4. STT (SPEECH-TO-TEXT) SERVER ──────────────────────────────────────────
# whisper.cpp Vulkan server offloaded to AMD Radeon 680M iGPU
WHISPER_SERVER_URL=http://127.0.0.1:8081/inference

# ─── 5. TTS (TEXT-TO-SPEECH) SYNTHESIZER ─────────────────────────────────────
# Piper ONNX neural voices running on AMD Ryzen 7 6800H CPU via AVX2
PIPER_MODEL_PATH=models/tts/en-us-lessac-medium.onnx

# ─── 6. AUDIO CAPTURE & FULL-DUPLEX ACOUSTICS ────────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_SILENCE_THRESHOLD_MS=130
AUDIO_BARGE_IN_ENABLED=true

# ─── 7. VISION & SPATIAL PERCEPTION ──────────────────────────────────────────
CAMERA_ENABLED=true
CAMERA_INDEX=0
YUNET_MODEL_PATH=models/vision/face_detection_yunet.onnx
YOLO_MODEL_PATH=models/vision/yolov8n.pt

# ─── 8. MEMORY, DATABASES & VECTOR STORE ─────────────────────────────────────
DATABASE_PATH=data/database/conversations.db
SCHEDULER_DB_PATH=data/database/scheduler.db
MEM0_VECTOR_STORE=qdrant
MEM0_QDRANT_PATH=data/memory/qdrant
MEM0_COLLECTION=robot_memory
FASTEMBED_CACHE_DIR=models/fastembed

# ─── 9. PERSONALITIES & CORE FASTAPI SERVER ──────────────────────────────────
DEFAULT_PERSONALITY=luna
ROBOT_API_HOST=127.0.0.1
ROBOT_API_PORT=8888
LOG_LEVEL=INFO
LOG_DIR=logs

# ─── 10. SPOTIFY & SMART HOME INTEGRATIONS (OPTIONAL) ────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_DEVICE_ID=
HASS_URL=
HASS_TOKEN=
